# Ready-to-run Docker demo defaults. No credentials or editing required.
# docker compose up --build -d --wait --wait-timeout 240
# Optional: copy to .env, edit your overrides, and run the same command.
# Compose always loads this file first; .env overrides these application settings.
# Host ports and artifact paths below match the defaults in compose.yaml.
COMPOSE_PROJECT_NAME=sfi-challenge
# Optional custom file: SFI_ENV_FILE=.env.custom (also use --env-file .env.custom).
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
BACKEND_PORT=8000
SIMULATOR_PORT=8087
MODEL_PORT=9000
MODEL_ARTIFACTS_DIR=./model/artifacts
BACKEND_HISTORY_DIR=./backend/data
MODEL_BUNDLE_NAME=freight-rpm-v1
MODEL_RANGE_NAME=historical-range-v1.json
MODEL_EXPECTED_VERSION=freight-rpm-v1

# Simulator: wall seconds between offers, simulated minutes before expiry.
SIMULATION_SPEED=10
ORDER_INTERVAL_SECONDS=5
ORDER_TTL_SIM_MINUTES=10
UNITS_PER_TERMINAL=8
HISTORY_ROWS=2500
BID_WIN_PROBABILITY=0.45
BID_DECISION_SIM_MINUTES=3
MAX_WEIGHT_LBS=44000

# Dispatcher. Leave history empty to disable import, or set
# HISTORY_CSV_PATH=/history/historical_shipments.csv to use your provided CSV.
HISTORY_CSV_PATH=
BOARD_WEBSOCKET_ENABLED=true
BOARD_SYNC_INTERVAL_SECONDS=30
SIMULATION_CLOCK_SYNC_INTERVAL_SECONDS=0.25
LOG_LIVE_ORDERS_VERBOSE=false

# Dispatcher business policy and advisory settings.
MAX_PICKUP_MOVE_MILES=100
MIN_EXPECTED_MARGIN_PCT=15
MIN_EXPECTED_MARGIN_USD=0
MAX_DEADHEAD_MILES=100
MIN_PICKUP_LEAD_MINUTES=0
PICKUP_BUFFER_MINUTES=0
ASSUMED_TRAVEL_SPEED_MPH=45
MAX_FLEET_SNAPSHOT_AGE_SECONDS=120
ENFORCE_MARGIN=true
TURNAROUND_MINUTES=30
RANK_EMPTY_MILES_WEIGHT=0.60
RANK_CONTINUITY_WEIGHT=0.25
RANK_UTILIZATION_WEIGHT=0.15
RANK_UTILIZATION_HORIZON_HOURS=24
RANK_PROFIT_WEIGHT=0.40
RANK_PROFIT_TARGET_PER_HOUR=100
OPPORTUNITY_COST_ENABLED=true
OPPORTUNITY_COST_PER_HOUR=25
POSITIONING_VALUE_ENABLED=true
POSITIONING_CREDIT_FRACTION=0.25
POSITIONING_MAX_CREDIT=500
HISTORICAL_MIN_SAMPLES=5
HISTORICAL_LOOKBACK_DAYS=365
HISTORICAL_ORIGIN_RADIUS_MILES=100
MODEL_API_TIMEOUT_SECONDS=10
MODEL_MAX_REFERENCE_DEVIATION_PCT=25

# Live autopilot needs both enable flags, both kill switches false, and matching
# backend/model tokens (at least 32 characters). Starting services starts no run.
AUTOPILOT_LIVE_ENABLED=false
AUTOPILOT_KILL_SWITCH=true
MODEL_AUTOPILOT_LIVE_TOKEN=
SFI_AUTOPILOT_LIVE_ENABLED=false
SFI_AUTOPILOT_KILL_SWITCH=true
SFI_AUTOPILOT_LIVE_TOKEN=
SFI_AUTOPILOT_ORDER_TYPES=open_bid,fixed_rate
SFI_AUTOPILOT_CLOCK_MODE=simulation
SFI_PRICING_FALLBACK_MODE=review
SFI_PRICING_UNSEEN_CATEGORY_ACTION=review
SFI_PRICING_MODEL_BLOCKED=false
