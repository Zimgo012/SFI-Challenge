# Set the external API URL to enable the startup hook.
EXTERNAL_API_URL=http://127.0.0.1:8087
LOG_LIVE_ORDERS_VERBOSE=false

# Maximum straight-line miles from a fleet unit to pickup (inclusive).
MAX_PICKUP_MOVE_MILES=100

# Advisory unit/order ranking weights and simulated utilization horizon.
RANK_EMPTY_MILES_WEIGHT=0.60
RANK_CONTINUITY_WEIGHT=0.25
RANK_UTILIZATION_WEIGHT=0.15
RANK_UTILIZATION_HORIZON_HOURS=24

# Dispatcher safety and profitability limits
MIN_EXPECTED_MARGIN_PCT=15
MIN_EXPECTED_MARGIN_USD=0
MAX_DEADHEAD_MILES=100
MAX_WEIGHT_LBS=44000
MIN_PICKUP_LEAD_MINUTES=0
PICKUP_BUFFER_MINUTES=0
ASSUMED_TRAVEL_SPEED_MPH=45
MAX_FLEET_SNAPSHOT_AGE_SECONDS=120

# REST reconciliation and simulator history import (empty disables CSV import).
BOARD_SYNC_INTERVAL_SECONDS=30
BOARD_WEBSOCKET_ENABLED=true
HISTORY_CSV_PATH=../sfi_challenge/data/historical_shipments.csv

# Profit evaluation is deferred for the dispatch pipeline
ENFORCE_MARGIN=true

# Post-delivery unit turnaround in simulated minutes
TURNAROUND_MINUTES=30

# Informational capacity and destination profit estimates
OPPORTUNITY_COST_ENABLED=true
OPPORTUNITY_COST_PER_HOUR=25
POSITIONING_VALUE_ENABLED=true
POSITIONING_CREDIT_FRACTION=0.25
POSITIONING_MAX_CREDIT=500
HISTORICAL_MIN_SAMPLES=5
HISTORICAL_LOOKBACK_DAYS=365
HISTORICAL_ORIGIN_RADIUS_MILES=100
RANK_PROFIT_WEIGHT=0.40
RANK_PROFIT_TARGET_PER_HOUR=100

# Separate testing backend (service.testing_server only)
TEST_SIMULATOR_URL=http://127.0.0.1:8090
TEST_DISPATCHER_DATABASE_URL=sqlite:///data/dispatcher-test.db
TEST_HISTORY_CSV_PATH=

# On-demand price analysis; only used by the separate analysis API.
MODEL_API_URL=http://127.0.0.1:9000
MODEL_API_TIMEOUT_SECONDS=10
MODEL_MAX_REFERENCE_DEVIATION_PCT=25

# Backend live execution gate. A live run must still be explicitly started.
# Model bids also require authenticated live eligibility and operational checks.
AUTOPILOT_LIVE_ENABLED=true
# Match the model server's SFI_AUTOPILOT_LIVE_TOKEN (at least 32 characters).
# Docker supplies a shared token automatically. For direct local processes,
# configure and export a matching token to the backend and model services.
MODEL_AUTOPILOT_LIVE_TOKEN=
SFI_AUTOPILOT_LIVE_TOKEN=
SFI_AUTOPILOT_LIVE_ENABLED=true
SFI_AUTOPILOT_KILL_SWITCH=false
SFI_AUTOPILOT_ORDER_TYPES='open_bid,fixed_rate'
SFI_AUTOPILOT_CLOCK_MODE=simulation
SFI_PRICING_FALLBACK_MODE=baseline
SFI_PRICING_UNSEEN_CATEGORY_ACTION=baseline
SFI_PRICING_MODEL_BLOCKED=false
AUTOPILOT_KILL_SWITCH=false
MODEL_MONITORING_BUNDLE=../model/artifacts/models/freight-rpm-v1
